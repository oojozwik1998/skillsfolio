---
import Button from './ui/button/Button.astro';

interface Props {
  command: string;
}

const { command } = Astro.props;
---

<div
  class="bg-surface-default border-border-subtle rounded-16 flex flex-col gap-3 border p-3 sm:flex-row sm:items-center"
  data-install-command
>
  <code class="type-code min-w-0 flex-1 px-2 py-1 break-all sm:break-normal">{command}</code>
  <Button data-command={command}>
    <span aria-live="polite">Copy</span>
  </Button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-command]').forEach((button) => {
    const label = button.querySelector('span');
    if (!label) return;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.command ?? '');
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Copy failed';
      }
    });
  });
</script>
