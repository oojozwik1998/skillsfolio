---
/**
 * Native button for actions on the page, such as copying. Use TextLink for
 * navigation. Put a result that changes the label inside an aria-live region.
 */
import type { HTMLAttributes } from 'astro/types';
import { type ButtonAppearance, buttonClasses } from '../../../lib/ui';

export interface Props extends HTMLAttributes<'button'> {
  appearance?: ButtonAppearance;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
}

const { appearance = 'secondary', type = 'button', disabled = false, class: className, ...rest } = Astro.props;
---

<button type={type} disabled={disabled} class:list={[buttonClasses(appearance), className]} {...rest}><slot /></button>
