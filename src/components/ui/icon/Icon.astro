---
/**
 * Decorative icon drawn with currentColor. Always hidden from assistive tech,
 * so it must never be the only carrier of meaning. The parent sets rotation.
 */
import { type IconName, iconPaths } from '../../../lib/ui';

export interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['size-(--ds-size-icon-sm) shrink-0', className]}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={iconPaths[name]} />
</svg>
