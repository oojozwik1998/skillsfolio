---
import { getCollection, render } from 'astro:content';
import CopyCommand from '../../components/ui/copy-command/CopyCommand.astro';
import TextLink from '../../components/ui/link/TextLink.astro';
import PageHeader from '../../components/ui/page-header/PageHeader.astro';
import { site } from '../../config';
import Base from '../../layouts/Base.astro';
import { installCommand, sourceUrl } from '../../lib/skills';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  return skills.map((skill) => ({ params: { name: skill.data.name }, props: { skill } }));
}

const { skill } = Astro.props;
const { name, description } = skill.data;
const { Content } = await render(skill);
---

<Base title={name} description={description}>
  <article class="max-w-3xl">
    <PageHeader title={name} lead={description} backHref="/" size="small" />

    <section class="mt-12" aria-labelledby="install-heading">
      <h2 id="install-heading" class="type-heading-small mb-4">Install</h2>
      <CopyCommand command={installCommand(site.repository, name)} />
      <TextLink href={sourceUrl(site.repository, name)} tone="subtle" class="mt-4 inline-block">
        View source on GitHub
      </TextLink>
    </section>

    <hr class="border-border-subtle my-12" />

    <div class="skill-body">
      <Content />
    </div>
  </article>
</Base>
