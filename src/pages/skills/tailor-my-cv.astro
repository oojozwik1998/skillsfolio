---
import CopyCommand from '../../components/ui/copy-command/CopyCommand.astro';
import Callout from '../../components/ui/callout/Callout.astro';
import Card from '../../components/ui/card/Card.astro';
import Disclosure from '../../components/ui/disclosure/Disclosure.astro';
import Icon from '../../components/ui/icon/Icon.astro';
import InlineCode from '../../components/ui/inline-code/InlineCode.astro';
import TextLink from '../../components/ui/link/TextLink.astro';
import PageHeader from '../../components/ui/page-header/PageHeader.astro';
import SectionHeader from '../../components/ui/section-header/SectionHeader.astro';
import { externalSkills } from '../../data/external-skills';
import {
  factMarks,
  files,
  installFolder,
  lanes,
  memoryCards,
  repository,
  requirements,
  steps,
  truthCards,
  type Actor,
} from '../../data/tailor-my-cv';
import Base from '../../layouts/Base.astro';
import { cloneCommand, repositoryUrl } from '../../lib/skills';
import { badgeLabels } from '../../lib/ui';

const description = externalSkills.find(({ data }) => data.name === 'tailor-my-cv')?.data.description;

const actorStage: Record<Actor, string> = {
  you: 'bg-actor-you-background border-actor-you-border text-actor-you-text',
  skill: 'bg-actor-skill-background border-actor-skill-border text-actor-skill-text',
};
---

<Base title="How tailor-my-cv works" description={description}>
  <article>
    <PageHeader
      title="How tailor-my-cv works"
      lead="Paste a job offer. The skill assesses your fit and makes a CV for that offer, in your layout and using only true facts. With each application, it knows more about you."
      backHref="/"
      class="max-w-3xl"
    />

    <section class="mt-12 max-w-3xl" aria-labelledby="install-heading">
      <SectionHeader id="install-heading" title="Install" class="mb-6" />
      <p class="type-text-medium text-text-subtle mb-4">
        This skill is a complete workspace, so you download its repository instead of using <InlineCode>npx skills add</InlineCode>.
      </p>
      <CopyCommand command={cloneCommand(repository, installFolder)} />
      <ol class="type-text-medium rich-text mt-6 list-decimal space-y-1 pl-5">
        <li>Go to the folder: <code>cd {installFolder}</code></li>
        <li>Check your setup: <code>scripts/doctor.sh</code></li>
        <li>Start Claude Code with <code>claude</code>, then paste a job offer or a link to one.</li>
      </ol>
      <h3 class="type-heading-small mt-8">Requirements</h3>
      <ul class="type-text-medium rich-text mt-3 list-disc space-y-1 pl-5">
        {requirements.map((item) => <li set:html={item} />)}
      </ul>
      <TextLink href={repositoryUrl(repository)} tone="subtle" class="mt-6 inline-block">
        View repository on GitHub
      </TextLink>
    </section>

    <section class="mt-20" aria-labelledby="process-heading">
      <SectionHeader id="process-heading" title="The whole process on one picture" subtitle="Click a stage to see its details below." />
      <div class="type-text-small text-text-subtle mt-4 flex gap-4">
        <span class="flex items-center gap-2">
          <i class="bg-actor-skill-border rounded-2 size-3" aria-hidden="true"></i> The skill works
        </span>
        <span class="flex items-center gap-2">
          <i class="bg-actor-you-border rounded-2 size-3" aria-hidden="true"></i> You decide
        </span>
      </div>

      {
        lanes.map((lane) => (
          <div class="mt-8">
            <h3 class="type-label text-text-subtle mb-3">{lane.label}</h3>
            <ol class="flex flex-col gap-6 lg:flex-row">
              {lane.stages.map((stage, index) => (
                <li class="relative min-w-0 flex-1">
                  <a
                    href={`#step-${stage.step}`}
                    class:list={[
                      'rounded-12 block h-full border p-3 hover:underline',
                      actorStage[stage.actor],
                    ]}
                  >
                    <span class="type-text-small block">{badgeLabels[stage.actor]}</span>
                    <span class="type-text-medium block">{stage.label}</span>
                  </a>
                  {index < lane.stages.length - 1 && (
                    <Icon name="arrow-right" class="text-text-subtle absolute -bottom-5.5 left-6 rotate-90 lg:top-1/2 lg:-right-5 lg:bottom-auto lg:left-auto lg:-translate-y-1/2 lg:rotate-0" />
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))
      }

      <Callout class="mt-6">
        <Icon slot="icon" name="loop" class="mt-0.5" />
        Your answers and rejected suggestions go into the fact base, so the next offer starts with more knowledge.
      </Callout>
    </section>

    <section class="mt-20" aria-labelledby="steps-heading">
      <SectionHeader id="steps-heading" title="Step by step" subtitle="The examples come from tests with a fictional person: Sam Example, a data analyst." />
      <div class="mt-6 flex flex-col gap-3">
        {
          steps.map((step, index) => (
            <Disclosure
              id={`step-${index + 1}`}
              number={index + 1}
              title={step.title}
              badge={step.actor}
              open={index === 0}
            >
              <div class="grid gap-6 md:grid-cols-2">
                {step.columns.map((column) => (
                  <div>
                    <h3 class="type-label text-text-subtle mb-2">{column.heading}</h3>
                    <ul class="type-text-medium rich-text list-disc space-y-1 pl-5">
                      {column.items.map((item) => (
                        <li set:html={item} />
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              {step.example && (
                <Callout appearance="example" label="From testing" class="mt-6">
                  {step.example}
                </Callout>
              )}
            </Disclosure>
          ))
        }
      </div>
    </section>

    <section class="mt-20" aria-labelledby="layout-heading">
      <SectionHeader id="layout-heading" title="Does the layout really match?" subtitle="A test on Sam’s two-column CV. This is the screen you get to approve on the first run." />
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <figure>
          <img
            src="/images/tailor-my-cv/cv-original.png"
            alt="Sam’s original two-column CV with a green sidebar"
            width="662"
            height="936"
            loading="lazy"
            class="border-border-subtle rounded-12 h-auto w-full border"
          />
          <figcaption class="type-text-small text-text-subtle mt-2">The original, added as a PDF</figcaption>
        </figure>
        <figure>
          <img
            src="/images/tailor-my-cv/cv-recreated.png"
            alt="Sam’s CV recreated by the skill, very close to the original"
            width="662"
            height="936"
            loading="lazy"
            class="border-border-subtle rounded-12 h-auto w-full border"
          />
          <figcaption class="type-text-small text-text-subtle mt-2">
            The version recreated by the skill, with small differences in sizes and spacing
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="mt-20" aria-labelledby="truth-heading">
      <SectionHeader id="truth-heading" title="Where the line of truth is" />
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {
          truthCards.map((card) => (
            <Card accent={card.tone}>
              <h3 class="type-heading-small">{card.title}</h3>
              <ul class="type-text-medium rich-text list-disc space-y-1 pl-5">
                {card.items.map((item) => (
                  <li set:html={item} />
                ))}
              </ul>
            </Card>
          ))
        }
      </div>
    </section>

    <section class="mt-20" aria-labelledby="memory-heading">
      <SectionHeader id="memory-heading" title="What the skill remembers about you" subtitle="Every fact is marked with where it came from. That decides how it can be used." />
      <div class="bg-surface-default border-border-subtle rounded-16 mt-6 overflow-hidden border">
        <table class="type-text-medium w-full text-left">
          <thead class="text-text-subtle">
            <tr>
              <th scope="col" class="type-label p-3 sm:px-4">Mark</th>
              <th scope="col" class="type-label p-3 sm:px-4">Meaning</th>
              <th scope="col" class="type-label p-3 sm:px-4">In the CV</th>
            </tr>
          </thead>
          <tbody class="rich-text">
            {
              factMarks.map((row) => (
                <tr class="border-border-subtle border-t align-top">
                  <th scope="row" class="py-3 pr-1 pl-3 font-normal sm:px-4">
                    <code class="whitespace-nowrap">{row.mark}</code>
                  </th>
                  <td class="px-2 py-3 sm:px-4">{row.meaning}</td>
                  <td class="px-2 py-3 sm:px-4">{row.inCv}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {
          memoryCards.map((card) => (
            <Card>
              <h3 class="type-heading-small">{card.title}</h3>
              <ul class="type-text-medium rich-text list-disc space-y-1 pl-5">
                {card.items.map((item) => (
                  <li set:html={item} />
                ))}
              </ul>
            </Card>
          ))
        }
      </div>
    </section>

    <section class="mt-20" aria-labelledby="files-heading">
      <SectionHeader id="files-heading" title="Where everything lives" />
      <dl class="bg-surface-default border-border-subtle rounded-16 rich-text type-text-medium mt-6 border">
        {
          files.map((file, index) => (
            <div
              class:list={[
                'grid gap-1 p-3 sm:grid-cols-[18rem_1fr] sm:gap-4 sm:px-4',
                { 'border-border-subtle border-t': index > 0 },
              ]}
            >
              <dt>
                <code class:list={['break-all', { 'text-actor-you-text': file.isPrivate }]}>{file.path}</code>
              </dt>
              <dd>{file.description}</dd>
            </div>
          ))
        }
      </dl>
      <p class="type-text-medium text-text-subtle mt-4 max-w-2xl">
        Private files are excluded from git, and a check confirms this on every run. Your CV and offers are still
        processed by an AI model as part of normal Claude Code use.
      </p>
    </section>

    <p class="border-border-subtle type-text-small text-text-subtle mt-20 border-t pt-6">
      Status as of 2026-11-06, tested on macOS. Sam Example and the companies in the examples are fictional. Linux and
      a test with an outside user are still to come.
    </p>
  </article>
</Base>

