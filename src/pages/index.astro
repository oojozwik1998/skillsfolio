---
import { getCollection } from 'astro:content';
import AsciiField from '../components/ui/ascii-field/AsciiField.astro';
import LinkCard from '../components/ui/link-card/LinkCard.astro';
import PageHeader from '../components/ui/page-header/PageHeader.astro';
import { site } from '../config';
import { externalSkills } from '../data/external-skills';
import Base from '../layouts/Base.astro';
import { sortByName } from '../lib/skills';

const skills = sortByName([...(await getCollection('skills')), ...externalSkills]);
---

<Base>
  <AsciiField />
  <PageHeader title={site.name} lead={site.description} class="max-w-2xl" />

  {
    skills.length > 0 ? (
      <ul class="mt-16 grid gap-4 md:grid-cols-2">
        {skills.map((skill) => (
          <li>
            <LinkCard
              href={`/skills/${skill.data.name}/`}
              title={skill.data.name}
              description={skill.data.description}
            />
          </li>
        ))}
      </ul>
    ) : (
      <p class="type-text-medium text-text-subtle mt-16">No skills published yet.</p>
    )
  }
</Base>
